# =====================================================
# BookSwap Hub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =====================================================

# Flask Configuration
FLASK_ENV=development

# Security Secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret
JWT_SECRET=replace-with-a-strong-random-jwt-secret

# Server Configuration
PORT=5000
FRONTEND_ORIGIN=http://127.0.0.1:5000
FRONTEND_URL=http://127.0.0.1:5000

# Email Configuration (Gmail SMTP)
# Use a Gmail App Password — NOT your real Gmail password.
# Enable 2FA first, then generate at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Google Books API
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=your-google-books-api-key-here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookswap
DB_USER=postgres
DB_PASSWORD=your-db-password-here
